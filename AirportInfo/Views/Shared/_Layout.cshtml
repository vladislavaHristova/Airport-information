<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Flight Booking</title>
</head>
<body>
    <nav style="background-color: #007bff; padding: 15px; color: white;">
        <div style="max-width: 1200px; margin: 0 auto;">
            <a href="/" style="color: white; text-decoration: none; font-size: 20px; font-weight: bold;">
                Flight Booking System
            </a>
            <a href="/Flights" style="color: white; text-decoration: none; margin-left: 20px;">
                Flights
            </a>
        </div>
    </nav>

    <main style="max-width: 1200px; margin: 0 auto; padding: 20px;">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>