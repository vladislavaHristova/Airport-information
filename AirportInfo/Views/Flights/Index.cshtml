@model IEnumerable<AirportInfo.Models.FlightViewModel>

@{
    ViewData["Title"] = "Полети";
}

<h2>Списък с полети</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="row mb-3">
    <div class="col-md-6">
        <form asp-action="Search" method="post" class="input-group">
            <input type="text" name="destination" class="form-control" placeholder="Търси по дестинация..." />
            <button type="submit" class="btn btn-primary">Търси</button>
        </form>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Index" class="btn btn-secondary">Изчисти</a>
    </div>
</div>


<div class="mb-3">
    <a asp-action="Index" asp-route-sortBy="time" class="btn btn-sm btn-outline-secondary">Сортирай по час</a>
    <a asp-action="Index" asp-route-sortBy="airline" class="btn btn-sm btn-outline-secondary">Сортирай по авиокомпания</a>
    <a asp-action="Index" asp-route-sortBy="destination" class="btn btn-sm btn-outline-secondary">Сортирай по дестинация</a>
</div>


<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Полет</th>
            <th>Авиокомпания</th>
            <th>От</th>
            <th>До</th>
            <th>Заминава</th>
            <th>Пристига</th>
            <th>Статус</th>
            <th>Гейт/Терминал</th>
            <th>Действие</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var flight in Model)
        {
            <tr>
                <td>@flight.FlightNumber</td>
                <td>@flight.Airline</td>
                <td>@flight.FromCity (@flight.FromCode)</td>
                <td>@flight.ToCity (@flight.ToCode)</td>
                <td>@flight.DepartureTimeDisplay</td>
                <td>@flight.ArrivalTimeDisplay</td>
                <td>@flight.StatusDisplay</td>
                <td>@flight.GateDisplay / T @flight.Terminal</td>
                <td>
                    <a asp-action="Book" asp-route-id="@flight.Id" class="btn btn-primary btn-sm">
                        Book Flight
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>